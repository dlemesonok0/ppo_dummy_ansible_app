[Unit]
Description=HTTP frontend and /health alias for Podinfo demo
Requires=docker.service
Wants=ansiballz-demo.service
After=docker.service ansiballz-demo.service

[Service]
Type=simple
ExecStartPre=-/usr/bin/docker rm -f ansiballz-demo-web
ExecStart=/usr/bin/docker run --rm --pull=never --name ansiballz-demo-web --network host --read-only --tmpfs /tmp:rw,nosuid,size=16m --security-opt no-new-privileges --memory 64m --cpus 0.25 --volume /opt/ansiballz-demo/nginx.conf:/etc/nginx/nginx.conf:ro --entrypoint nginx nginx:1.28.0-alpine@sha256:30f1c0d78e0ad60901648be663a710bdadf19e4c10ac6782c235200619158284 -c /etc/nginx/nginx.conf -g "daemon off;"
ExecStop=/usr/bin/docker stop --time 5 ansiballz-demo-web
ExecStopPost=-/usr/bin/docker rm -f ansiballz-demo-web
Restart=on-failure
RestartSec=2
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
