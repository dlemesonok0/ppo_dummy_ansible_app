[Unit]
Description=Podinfo release demo managed by systemd
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=-/usr/bin/docker rm -f ansiballz-demo
ExecStart=/opt/ansiballz-demo/run.sh
ExecStop=/usr/bin/docker stop --time 10 ansiballz-demo
ExecStopPost=-/usr/bin/docker rm -f ansiballz-demo
Restart=on-failure
RestartSec=2
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
